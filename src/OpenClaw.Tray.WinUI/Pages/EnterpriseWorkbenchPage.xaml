<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.EnterpriseWorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,36" Spacing="16" MaxWidth="1100" HorizontalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="企业工作台"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.AutomationId="EnterpriseWorkbenchPageMarker"/>
                <TextBlock Text="从模板发起工作，保留执行与审批记录。技术设置仍在管理中心。"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <InfoBar x:Name="WorkspaceInfoBar" IsOpen="False" IsClosable="True"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="16" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4"><TextBlock Text="可用模板" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock x:Name="TemplateCountText" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4"><TextBlock Text="待我审批" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock x:Name="ApprovalCountText" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4"><TextBlock Text="已交付任务" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock x:Name="DeliveredCountText" Style="{StaticResource TitleTextBlockStyle}"/></StackPanel>
                </Border>
            </Grid>

            <Border Padding="18" CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3"><TextBlock Text="工作模板" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="先从可复用的岗位结果开始，而不是从模型和工具开始。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        <Button Grid.Column="1" Content="新建会议纪要" Click="OnNewMeetingMinutesClick" AutomationProperties.Name="新建会议纪要任务"/>
                    </Grid>
                    <ItemsRepeater x:Name="TemplatesRepeater">
                        <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="230" MinRowSpacing="10" MinColumnSpacing="10"/></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="6"><TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border x:Name="MeetingFormCard" Visibility="Collapsed" Padding="18" CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="发起会议纪要" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="任务启动后会将内容发送到当前 Gateway 对话。AI 结果仍需要由负责人确认后再提交审批。" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="MeetingTitleBox" Header="会议名称" PlaceholderText="例如：7 月销售例会"/>
                    <TextBox x:Name="MeetingNotesBox" Header="会议记录" PlaceholderText="粘贴会议记录、结论或待办。内容仅保存在本机任务记录和已连接的 Gateway 中。" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="取消" Click="OnCancelMeetingMinutesClick"/><Button x:Name="StartMeetingTaskButton" Content="启动并发送到对话" Click="OnStartMeetingTaskClick" AutomationProperties.Name="启动会议纪要任务"/></StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3"><TextBlock Text="任务与交付记录" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock x:Name="RoleText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    <StackPanel x:Name="TasksPanel" Spacing="10"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
