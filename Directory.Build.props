<Project>

  <PropertyGroup>
    <MicrosoftWindowsAppSDKVersion>2.3.1</MicrosoftWindowsAppSDKVersion>
    <MicrosoftWindowsSdkBuildToolsVersion>10.0.28000.2526</MicrosoftWindowsSdkBuildToolsVersion>
  </PropertyGroup>

  <!-- NuGet's WinUI PRI props are evaluated after project item groups.
       Exclude all implicit locale resources early for the branded build;
       the tray project then includes its one generated zh-CN resource explicitly. -->
  <PropertyGroup Condition="'$(XiaozaBuild)' == 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);Strings\**\*.resw;XiaozaclawStrings\**\*.resw</DefaultItemExcludes>
  </PropertyGroup>

</Project>
